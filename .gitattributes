# Stable source bytes and readable diffs across Windows/Linux checkouts.
* text=auto
*.py text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf

# Preserve publisher annotation bytes and their declared SHA-256 identities.
/data/sources/SAMM/*.json -text
