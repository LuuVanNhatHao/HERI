!/data/sources/SAMM/train.json
!/data/sources/SAMM/val.json
!/data/sources/SAMM/test.json
!/data/sources/SAMM/LICENSE
!/data/sources/SAMM/NOTICE

# Local research notes, checks and generated products are not distributed.
/artifacts/
/docs/
/tests/

