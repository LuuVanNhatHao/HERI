# Public dataset manifests and original SAMM annotation snapshot.
/data/*
!/data/README.md
!/data/SAMM-20K/
/data/SAMM-20K/*
!/data/SAMM-20K/manifest.json
!/data/sources/
/data/sources/*
!/data/sources/SAMM/
